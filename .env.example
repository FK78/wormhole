WORMHOLE_PORT=3000
SHUTDOWN_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_HEALTH_CHECK_INTERVAL_MS=5000
LOG_LEVEL=info
RUN_MIGRATIONS_ON_STARTUP=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
POSTGRES_DB=wormhole
POSTGRES_PORT=5432
# The dev database is published on IPv4 loopback; this avoids systems where
# `localhost` resolves to ::1 first.
HOST=127.0.0.1
