{
  "name": "wormhole",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/FK78/wormhole#readme",
  "bugs": {
    "url": "https://github.com/FK78/wormhole/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FK78/wormhole.git"
  },
  "license": "MIT",
  "author": "FK78",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file .env --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file .env dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "db:migrate:down": "node --env-file-if-exists=.env src/db/migrate.ts down",
    "db:migrate:status": "node --env-file-if-exists=.env src/db/migrate.ts status",
    "db:baseline": "node --env-file-if-exists=.env src/db/migrate.ts baseline",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "test:migrations": "node --test --test-concurrency=1 \"test/unit/migrations.test.ts\" \"test/integration/migrations.test.ts\""
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "express": "5.3.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  }
}
